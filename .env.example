# Root .env.example — see backend/.env.example for the authoritative list.
# This file mirrors the values docker-compose reads for local infrastructure.

# PostgreSQL (local dev / docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ojt_management

# MinIO (local dev / docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=ojt-evidence
