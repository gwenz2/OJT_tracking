# ---------- App ----------
# development | staging | production
APP_ENV=development
APP_NAME=OJT Attendance
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=30s
# Max JSON request body (e.g. 1MB). Evidence uploads use EVIDENCE_UPLOAD_LIMIT.
APP_BODY_LIMIT=1MB
# Max multipart attendance upload (photo <= 5MB + form overhead)
EVIDENCE_UPLOAD_LIMIT=6MB

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ojt_management
DB_USER=postgres
# REQUIRED in production — empty fails startup validation there.
DB_PASSWORD=
# disable (local dev only) | require | verify-full (production)
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

# ---------- Object storage (S3-compatible; MinIO locally) ----------
S3_ENDPOINT=127.0.0.1:9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ojt-evidence
# How long presigned evidence read URLs stay valid
S3_PRESIGN_TTL=5m
# Browser-facing host for presigned evidence URLs when S3_ENDPOINT is not
# reachable by clients (e.g. internal compose DNS). The reverse proxy must
# forward /{S3_BUCKET}/* to object storage with the Host header intact.
# S3_PUBLIC_ENDPOINT=ojt.example.edu
# S3_PUBLIC_SSL=true

# ---------- Session / CSRF ----------
SESSION_TTL=12h
SESSION_COOKIE_NAME=ojt_session
# MUST be true in production (HTTPS). Validation refuses false there.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
# Explicit origins allowed for CSRF Origin checks. Empty in production blocks
# all cross-origin requests. Never use * with cookie auth.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Rate limits ----------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1m
ATTENDANCE_RATE_LIMIT_MAX=20
ATTENDANCE_RATE_LIMIT_WINDOW=1m

# ---------- Logging ----------
LOG_LEVEL=info
# console | json (use json in production)
LOG_FORMAT=console

# ---------- Admin bootstrap (used only by `api --seed-admin`) ----------
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Administrator
