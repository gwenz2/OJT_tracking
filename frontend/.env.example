# Frontend environment (Vite). Copy to .env for local overrides.
# In dev, /api is proxied to the backend (see vite.config.ts) so this can stay unset.
# Set this only when the API lives on a different origin (not recommended —
# same-origin keeps cookie + CSRF posture simple).
# VITE_API_URL=http://localhost:8080/api/v1
